{
  "name": "@markora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=development --import tsx --watch src/main.ts",
    "bootstrap:admin": "node --env-file-if-exists=../../.env --conditions=development --import tsx src/bootstrap-admin.ts",
    "start": "node dist/main.js",
    "build": "tsup src/main.ts src/bootstrap-admin.ts --format esm --platform node --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:integration": "vitest run integration --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@markora/config": "workspace:*",
    "@markora/contracts": "workspace:*",
    "@markora/database": "workspace:*",
    "@markora/domain": "workspace:*",
    "@markora/portability": "workspace:*",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/platform-express": "11.1.29",
    "argon2": "0.45.1",
    "express": "5.2.1",
    "multer": "2.2.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.0.0",
    "@types/pg": "8.21.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsup": "8.5.1"
  }
}
