{
  "name": "markora",
  "version": "0.1.0-rc.1",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": ">=10.28.2 <11"
  },
  "scripts": {
    "postinstall": "pnpm db:generate",
    "build": "pnpm -r --if-present build",
    "bootstrap:admin": "pnpm --filter @markora/api bootstrap:admin",
    "dev": "pnpm --parallel --filter @markora/web --filter @markora/api --filter @markora/worker dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @markora/database test:integration && pnpm --filter @markora/api test:integration && pnpm --filter @markora/worker test:integration",
    "benchmark:release": "pnpm --filter @markora/worker exec vitest run benchmarks/release-benchmark.test.ts --maxWorkers=1 --no-file-parallelism --reporter=verbose",
    "openapi:generate": "pnpm --filter @markora/contracts openapi:generate",
    "openapi:check": "pnpm --filter @markora/contracts openapi:check",
    "db:validate": "prisma validate --config database/prisma.config.ts",
    "db:generate": "prisma generate --config database/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config database/prisma.config.ts",
    "verify": "pnpm db:generate && pnpm lint && pnpm typecheck && pnpm test && pnpm openapi:check && pnpm db:validate && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "26.2.0",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "reflect-metadata": "0.2.2",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
