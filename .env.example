NODE_ENV=development
PUBLIC_ORIGIN=http://localhost:27180
API_HOST=0.0.0.0
API_PORT=27184
WEB_HOST=0.0.0.0
WEB_PORT=27183
DATABASE_URL=postgresql://markora:markora@localhost:27185/markora?schema=public
TEST_DATABASE_URL=postgresql://markora:markora@localhost:27185/markora_test?schema=public
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_ATTEMPTS=5
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
LOG_LEVEL=info
TEMP_ROOT=./tmp
WORKSPACE_MAX_DEPTH=32
WORKSPACE_NAME_MAX_CODE_POINTS=255
DOCUMENT_MAX_BYTES=5242880
DOCUMENT_LARGE_BYTES=1048576
DOCUMENT_LARGE_LINES=50000
VERSION_SNAPSHOT_INTERVAL_MINUTES=10

# Required only when running the one-time bootstrap command.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
