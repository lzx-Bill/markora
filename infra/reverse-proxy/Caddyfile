{$MARKORA_SITE_ADDRESS:http://localhost} {
  encode zstd gzip

  request_body {
    max_size 110MB
  }

  header {
    -Server
    X-Request-ID "{http.request.uuid}"
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:"
  }

  @api path /api/*
  handle @api {
    reverse_proxy api:27184 {
      header_up X-Request-ID {http.request.uuid}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  handle {
    reverse_proxy web:27183 {
      header_up X-Request-ID {http.request.uuid}
      header_up X-Forwarded-Proto {scheme}
    }
  }
}
