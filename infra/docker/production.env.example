# Public routing. Use an HTTPS origin and matching Caddy site address online.
PUBLIC_ORIGIN=https://markora.example.com
MARKORA_SITE_ADDRESS=markora.example.com
MARKORA_HTTP_PORT=80
MARKORA_HTTPS_PORT=443

# Generate independent high-entropy values; never commit the real file.
POSTGRES_DB=markora
POSTGRES_USER=markora
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters

MARKORA_IMAGE=markora:0.1.0-rc.1
MARKORA_VERSION=0.1.0-rc.1
LOG_LEVEL=info
