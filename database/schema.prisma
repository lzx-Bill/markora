generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AuditResult {
  SUCCESS
  FAILURE
}

enum ResourceState {
  ACTIVE
  TRASHED
  DELETING
}

enum DocumentVersionReason {
  AUTO_SAVE
  CONFLICT_OVERWRITE
  RESTORE
  IMPORT_REPLACE
}

enum BackgroundJobType {
  PERMANENT_DELETE_FOLDER
  PERMANENT_DELETE_DOCUMENT
  IMPORT
  EXPORT
}

enum BackgroundJobState {
  PENDING
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_ISSUES
  FAILED
  CANCELLED
  INTERRUPTED
}

enum JobItemState {
  PENDING
  RUNNING
  SUCCEEDED
  SKIPPED
  FAILED
  CANCELLED
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  username           String
  usernameCanonical  String            @unique @map("username_canonical")
  email              String
  emailCanonical     String            @unique @map("email_canonical")
  displayName        String            @map("display_name")
  passwordHash       String            @map("password_hash")
  role               UserRole          @default(USER)
  status             UserStatus        @default(ACTIVE)
  mustChangePassword Boolean           @default(false) @map("must_change_password")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace          Workspace?
  sessions           Session[]
  auditEvents        AuditEvent[]      @relation("AuditActor")
  documentVersions   DocumentVersion[]
  backgroundJobs     BackgroundJob[]
  importUploads      ImportUpload[]      @relation("ImportUploadOwner")
  importPlans        ImportPlan[]        @relation("ImportPlanOwner")
  preference         UserPreference?
  systemConfigUpdates SystemConfig[]     @relation("SystemConfigUpdater")

  @@map("users")
}

model UserPreference {
  userId        String   @id @map("user_id") @db.Uuid
  schemaVersion Int      @default(1) @map("schema_version")
  version       Int      @default(1)
  settings      Json     @default("{}") @map("settings_json") @db.JsonB
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model SystemConfig {
  key        String   @id
  typedValue Json     @map("typed_value") @db.JsonB
  version    Int      @default(1)
  updatedBy  String   @map("updated_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updater    User     @relation("SystemConfigUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)

  @@map("system_config")
}

model ServiceHeartbeat {
  service   String   @id
  instance  String
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  seenAt    DateTime @map("seen_at") @db.Timestamptz(3)
  metadata  Json     @default("{}") @map("metadata_json") @db.JsonB

  @@index([seenAt])
  @@map("service_heartbeats")
}

model Workspace {
  id               String            @id @default(uuid()) @db.Uuid
  ownerUserId      String            @unique @map("owner_user_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  owner            User              @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  auditEvents      AuditEvent[]
  folders          Folder[]
  documents        Document[]
  documentVersions DocumentVersion[]
  backgroundJobs   BackgroundJob[]
  importUploads    ImportUpload[]
  importPlans      ImportPlan[]

  @@map("workspaces")
}

model Folder {
  id                String        @id @default(uuid()) @db.Uuid
  workspaceId       String        @map("workspace_id") @db.Uuid
  parentId          String?       @map("parent_id") @db.Uuid
  name              String
  normalizedName    String        @map("normalized_name")
  state             ResourceState @default(ACTIVE)
  originalParentId  String?       @map("original_parent_id") @db.Uuid
  originalParentIsRoot Boolean    @default(false) @map("original_parent_is_root")
  originalPath      String?       @map("original_path")
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace         Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent            Folder?       @relation("FolderHierarchy", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  children          Folder[]      @relation("FolderHierarchy")
  originalParent    Folder?       @relation("FolderOriginalParent", fields: [originalParentId], references: [id], onDelete: SetNull)
  originalChildren  Folder[]      @relation("FolderOriginalParent")
  documents         Document[]    @relation("DocumentFolder")
  originalDocuments Document[]    @relation("DocumentOriginalFolder")

  @@unique([id, workspaceId])
  @@index([workspaceId, state, parentId])
  @@index([parentId])
  @@map("folders")
}

model Document {
  id               String                @id @default(uuid()) @db.Uuid
  workspaceId      String                @map("workspace_id") @db.Uuid
  folderId         String?               @map("folder_id") @db.Uuid
  name             String
  normalizedName   String                @map("normalized_name")
  markdown         String                @default("")
  revision         Int                   @default(1)
  state            ResourceState         @default(ACTIVE)
  originalFolderId String?               @map("original_folder_id") @db.Uuid
  originalFolderIsRoot Boolean           @default(false) @map("original_folder_is_root")
  originalPath     String?               @map("original_path")
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder           Folder?               @relation("DocumentFolder", fields: [folderId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  originalFolder   Folder?               @relation("DocumentOriginalFolder", fields: [originalFolderId], references: [id], onDelete: SetNull)
  versions         DocumentVersion[]
  saveReceipts     DocumentSaveReceipt[]

  @@unique([id, workspaceId])
  @@index([workspaceId, state, folderId, updatedAt(sort: Desc)])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id             String                @id @default(uuid()) @db.Uuid
  documentId     String                @map("document_id") @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  versionNo      Int                   @map("version_no")
  markdown       String
  documentName   String                @map("document_name")
  reason         DocumentVersionReason
  sourceRevision Int                   @map("source_revision")
  actorId        String                @map("actor_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  document       Document              @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor          User                  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNo])
  @@index([workspaceId, documentId, versionNo(sort: Desc)])
  @@map("document_versions")
}

model DocumentSaveReceipt {
  id               String   @id @default(uuid()) @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  clientMutationId String   @map("client_mutation_id") @db.Uuid
  baseRevision     Int      @map("base_revision")
  markdownHash     String   @map("markdown_hash")
  resultRevision   Int      @map("result_revision")
  versionCreated   Boolean  @map("version_created")
  savedAt          DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)
  document         Document @relation(fields: [documentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([documentId, clientMutationId])
  @@index([workspaceId, savedAt(sort: Desc)])
  @@map("document_save_receipts")
}

model BackgroundJob {
  id             String             @id @default(uuid()) @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  ownerUserId    String             @map("owner_user_id") @db.Uuid
  type           BackgroundJobType
  state          BackgroundJobState @default(PENDING)
  targetType     String             @map("target_type")
  targetId       String             @map("target_id") @db.Uuid
  progress       Int                @default(0)
  payload        Json               @default("{}") @map("payload_json") @db.JsonB
  checkpoint     Json               @default("{}") @map("checkpoint_json") @db.JsonB
  result         Json?              @map("result_json") @db.JsonB
  errorCode      String?            @map("error_code")
  idempotencyKey String?            @map("idempotency_key")
  parentJobId    String?            @map("parent_job_id") @db.Uuid
  cancellationRequested Boolean     @default(false) @map("cancellation_requested")
  attempts       Int                @default(0)
  runAfter       DateTime           @default(now()) @map("run_after") @db.Timestamptz(3)
  leaseOwner     String?            @map("lease_owner")
  leaseExpiresAt DateTime?          @map("lease_expires_at") @db.Timestamptz(3)
  startedAt      DateTime?          @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?          @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User               @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  parentJob      BackgroundJob?     @relation("JobRetryLineage", fields: [parentJobId], references: [id], onDelete: SetNull)
  retryJobs      BackgroundJob[]    @relation("JobRetryLineage")
  items          JobItem[]
  exportManifest ExportManifest?
  exportArtifact ExportArtifact?

  @@unique([ownerUserId, type, idempotencyKey])
  @@index([state, runAfter, leaseExpiresAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, targetType, targetId])
  @@map("background_jobs")
}

model JobItem {
  id         String       @id @default(uuid()) @db.Uuid
  jobId      String       @map("job_id") @db.Uuid
  sourceKey  String       @map("source_key")
  state      JobItemState @default(PENDING)
  payload    Json         @default("{}") @map("payload_json") @db.JsonB
  result     Json?        @map("result_json") @db.JsonB
  errorCode  String?      @map("error_code")
  attempts   Int          @default(0)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  job        BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, sourceKey])
  @@index([jobId, state, createdAt])
  @@map("job_items")
}

model ImportUpload {
  id           String       @id @default(uuid()) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  ownerUserId  String       @map("owner_user_id") @db.Uuid
  tokenHash    String       @unique @map("token_hash")
  tempPath     String       @map("temp_path")
  manifestHash String       @map("manifest_hash")
  manifest     Json         @map("manifest_json") @db.JsonB
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User         @relation("ImportUploadOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  plans        ImportPlan[]

  @@index([expiresAt])
  @@index([workspaceId, ownerUserId])
  @@map("import_uploads")
}

model ImportPlan {
  id             String       @id @default(uuid()) @db.Uuid
  uploadId       String       @map("upload_id") @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  ownerUserId    String       @map("owner_user_id") @db.Uuid
  targetFolderId String?      @map("target_folder_id") @db.Uuid
  manifestHash   String       @map("manifest_hash")
  preview        Json         @map("preview_json") @db.JsonB
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(3)
  executedJobId  String?      @unique @map("executed_job_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  upload         ImportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner          User         @relation("ImportPlanOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([workspaceId, ownerUserId])
  @@map("import_plans")
}

model ExportManifest {
  id        String               @id @default(uuid()) @db.Uuid
  jobId     String               @unique @map("job_id") @db.Uuid
  scope     String
  report    Json                 @default("{}") @map("report_json") @db.JsonB
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  job       BackgroundJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  items     ExportManifestItem[]

  @@map("export_manifests")
}

model ExportManifestItem {
  id               String         @id @default(uuid()) @db.Uuid
  manifestId       String         @map("manifest_id") @db.Uuid
  sourceDocumentId String         @map("source_document_id") @db.Uuid
  displayPath      String         @map("display_path")
  archivePath      String         @map("archive_path")
  markdown         String
  sourceRevision   Int            @map("source_revision")
  normalized       Boolean        @default(false)
  manifest         ExportManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@unique([manifestId, archivePath])
  @@index([manifestId, id])
  @@map("export_manifest_items")
}

model ExportArtifact {
  id        String        @id @default(uuid()) @db.Uuid
  jobId     String        @unique @map("job_id") @db.Uuid
  filePath  String        @map("file_path")
  byteSize  BigInt        @map("byte_size")
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  job       BackgroundJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("export_artifacts")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tokenHash        String    @unique @map("token_hash")
  familyId         String    @map("family_id") @db.Uuid
  userAgentSummary String    @map("user_agent_summary")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  occurredAt  DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?     @map("actor_user_id") @db.Uuid
  workspaceId String?     @map("workspace_id") @db.Uuid
  action      String
  targetType  String      @map("target_type")
  targetId    String?     @map("target_id")
  result      AuditResult
  requestId   String      @map("request_id")
  metadata    Json        @default("{}") @map("metadata_json") @db.JsonB
  actor       User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([occurredAt(sort: Desc)])
  @@index([actorUserId, action, result])
  @@map("audit_events")
}

model LoginAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  subjectHash  String    @map("subject_hash")
  networkHash  String    @map("network_hash")
  windowStart  DateTime  @map("window_start") @db.Timestamptz(3)
  count        Int       @default(0)
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([subjectHash, networkHash, windowStart])
  @@index([blockedUntil])
  @@map("login_attempts")
}
